# ==========================================================================
# NexoLaundry - Variables de entorno
# Copiar a .env (nunca commitear .env)
# ==========================================================================

# Entorno
NODE_ENV=development

# API
PORT=3000
API_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Base de datos
DATABASE_URL=postgresql://nexo:nexo@localhost:5432/nexolaundry
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# Autenticación (ADR-011)
JWT_ACCESS_SECRET=change-me-in-production-at-least-32-chars
JWT_REFRESH_SECRET=change-me-in-production-at-least-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Multi-tenant
TENANT_RESOLUTION=subdomain
TENANT_DOMAIN_BASE=nexolaundry.local

# Observabilidad
SENTRY_DSN=
LOG_LEVEL=debug

# Storage (Fase 3 habilitará S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# Integraciones externas (Fase 3 - dejar vacío hasta entonces)
AZUL_MERCHANT_ID=
AZUL_AUTH_KEY=
WHATSAPP_ACCESS_TOKEN=
DGII_PSE_URL=
